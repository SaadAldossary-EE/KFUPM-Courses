def seed_everything(student_id: int):
    random.seed(student_id)
    np.random.seed(student_id % (2**32 - 1))


def pos_to_index(pos, grid_size=GRID_SIZE):
    r, c = pos
    return r * grid_size + c


def index_to_pos(idx, grid_size=GRID_SIZE):
    return (idx // grid_size, idx % grid_size)


def state_to_index(pos, has_passenger, grid_size=GRID_SIZE):
    """
    Two-phase state encoding:
      has_passenger ∈ {0,1}
      total states = 49 * 2 = 98
    """
    return has_passenger * (grid_size * grid_size) + pos_to_index(pos, grid_size)


def index_to_state(state_idx, grid_size=GRID_SIZE):
    block = grid_size * grid_size
    has_passenger = state_idx // block
    pos_idx = state_idx % block
    pos = index_to_pos(pos_idx, grid_size)
    return pos, int(has_passenger)


def student_id_to_positions(student_id: int, grid_size=GRID_SIZE):
    """
    Deterministically generate:
      start S, pickup P, destination D

    Uses different parts of the ID to get different cells.
    Ensures all three are distinct (by shifting if needed).
    """
    total = grid_size * grid_size
    s = student_id % total
    p = (student_id // total) % total
    d = (student_id // (total * total)) % total

    # Ensure uniqueness with simple deterministic shifts
    if p == s:
        p = (p + 1) % total
    if d == s or d == p:
        d = (d + 2) % total
        if d == s or d == p:
            d = (d + 3) % total

    start = index_to_pos(s, grid_size)
    pickup = index_to_pos(p, grid_size)
    dest = index_to_pos(d, grid_size)
    return start, pickup, dest


def generate_obstacles(student_id: int, start_pos, pickup_pos, dest_pos,
                       grid_size=GRID_SIZE, obstacle_fraction=OBSTACLE_FRACTION):
    """Generate ~15% obstacles excluding S, P, D (deterministic)."""
    total = grid_size * grid_size
    k = int(round(obstacle_fraction * total))  # ~7

    banned = {pos_to_index(start_pos, grid_size),
              pos_to_index(pickup_pos, grid_size),
              pos_to_index(dest_pos, grid_size)}

    candidates = [i for i in range(total) if i not in banned]
    rng = random.Random(student_id + 13579)
    obstacle_idxs = rng.sample(candidates, k)
    return {index_to_pos(i, grid_size) for i in obstacle_idxs}


def print_grid(taxi_pos, pickup_pos, dest_pos, obstacles, grid_size=GRID_SIZE):
    """Visual helper."""
    grid = [['.' for _ in range(grid_size)] for _ in range(grid_size)]
