def get_next_state(current_pos, action, obstacles, grid_size=GRID_SIZE):  # DO NOT CHANGE THIS LINE
    """
    Movement rules:
    - Stay keeps taxi in place
    - Off-grid move -> taxi stays
    - Move into obstacle -> taxi stays
    """
    row, col = current_pos  # DO NOT CHANGE THIS LINE

    # [Task 1.1] Propose next State for UP
    if action == UP:
        new_row = row - 1
        new_col = col
    # [Task 1.2] Propose next State for DOWN
    elif action == DOWN:
        new_row = row + 1
        new_col = col
    # [Task 1.3] Propose next State for LEFT
    elif action == LEFT:
        new_row = row
        new_col = col - 1
    # [Task 1.4] Propose next State for RIGHT
    elif action == RIGHT:
        new_row = row
        new_col = col + 1
    # [Task 1.5] STAY action keeps the same State
    elif action == STAY:
        new_row = row
        new_col = col

    #(new_row, new_col) based on task 1.1 - 1.4



    # [Task 1.6] TODO: Enforce boundaries + obstacles:
    # - If (new_row,new_col) out of bounds -> return (row,col)
    if new_row < 0 or new_row >= grid_size or new_col < 0 or new_col >= grid_size:
     return row, col
    # - If (new_row,new_col) in obstacles -> return (row,col)
    if (new_row, new_col) in obstacles:
     return row, col

    return new_row, new_col  # DO NOT CHANGE THIS LINE

# ============================================================
# Task 2: step_env()  (two-stage transition + reward)
# ============================================================

def step_env(state_idx, action, pickup_pos, dest_pos, obstacles,
             grid_size=GRID_SIZE):
    """
    Given a full state index (pos + passenger flag) and an action, compute:
      next_state_idx, reward, done

    Two-stage logic:
    - If has_passenger==0 and next_pos==pickup_pos, then has_passenger becomes 1
    - Episode ends ONLY when next_pos==dest_pos and has_passenger==1
    """
    (pos, has_passenger) = index_to_state(state_idx, grid_size)

    # (Task 1 must be correct for this to work)
    next_pos = get_next_state(pos, action, obstacles, grid_size)

    # --- Calculate Energy cost and Reward---
    # [Task 2.1] Compute energy cost based on action outcome:
    if action == STAY:
     energy_cost = STAY_COST

    elif next_pos == pos:
     energy_cost = BUMP_COST

    else:
     energy_cost = MOVE_COST
        #   - STAY costs STAY_COST
        #   - If action != STAY but next_pos == pos -> bump cost
        #   - Else normal move cost
    # Convert to reward (we want to minimize energy_cost)
    reward = -energy_cost
    # Calculate reward

    # --- Passenger transition ---
    # [Task 2.2] Update passenger flag when reaching pickup state
    next_has_passenger = has_passenger  # Change This to true if next state is the pickup state.
    if has_passenger == 0 and next_pos == pickup_pos:
     next_has_passenger = 1

    # pickup bonus
    # [Task 2.3] If pickup happens now (0->1), add PICKUP_BONUS to reward
    if has_passenger == 0 and next_has_passenger == 1:
     reward = reward+ PICKUP_BONUS

    # --- Terminal condition (dropoff) ---
    # [Task 2.4] If next_pos==dest_pos AND next_has_passenger==1, episode ends
    done = False

    if next_pos == dest_pos and next_has_passenger == 1:
      done = True
    if done:
        reward = reward + DROPOFF_REWARD


    next_state_idx = state_to_index(next_pos, next_has_passenger, grid_size)
    return next_state_idx, reward, done

# ============================================================
# Task 3: Q-learning() (tabular Q-learning over 98 states)
# ============================================================

def q_learning(start_pos, pickup_pos, dest_pos, obstacles,
               num_episodes=EPISODES, alpha=ALPHA, gamma=GAMMA, epsilon=EPSILON,
               grid_size=GRID_SIZE):

    num_states = (grid_size * grid_size) * 2  # two passenger phases
    q_table = np.zeros((num_states, ACTIONS), dtype=float)

    start_state_init = state_to_index(start_pos, 0, grid_size)

    for ep in range(num_episodes):
        current_state = start_state_init  #DO NOT Change this line

        for t in range(MAX_STEPS_PER_EPISODE):

            # [Task 3.1] Choose an action using epsilon-greedy policy
            if random.random() < epsilon:
             action= random.randint(0, ACTIONS - 1)
            else:
              action = int(np.argmax(q_table[current_state]))
            #   - explore with probability epsilon
            #   - else exploit


            # Environment transition. Get next state based on the chosen action
            next_state, reward, done = step_env(current_state, action, pickup_pos, dest_pos, obstacles, grid_size) # DO NOT CHANGE

            # [Task 3.2] Q-learning update
            # Update current state Q value based on the algorithm
            best_next_q = 0 if done else np.max(q_table[next_state])
            q_table[current_state, action] += alpha * (
            reward + gamma * best_next_q - q_table[current_state, action])


            # [Task 3.3] Update the 'current_state' to the next_state
            current_state = next_state
            #End episode if goal is reached
            if done:  #DO NOT Change
                break

    return q_table  #DO NOT Change

# ============================================================
# DO NOT CHANGE: Greedy evaluation route
# ============================================================

def action_energy_cost(current_pos, action, next_pos):
    """
    Energy cost for a single step, consistent with the assignment's rules.
    - STAY always costs STAY_COST
    - If action != STAY but next_pos == current_pos -> bump (wall/obstacle) cost
    - Otherwise -> move cost
    """
    if action == STAY:
        return STAY_COST
    return BUMP_COST if next_pos == current_pos else MOVE_COST

def greedy_route(q_table, start_pos, pickup_pos, dest_pos, obstacles,
                 grid_size=GRID_SIZE, max_steps=200):
    """Follow greedy policy and return (route, reached_dropoff)."""
    s = state_to_index(start_pos, 0, grid_size)
    route = [index_to_state(s, grid_size)]
    total_energy = 0
    breakdown = {"move": 0, "stay": 0, "bump": 0}
    reached = False

    for _ in range(max_steps):
        (pos, has_passenger) = index_to_state(s, grid_size)
        if pos == dest_pos and has_passenger == 1:
            reached = True
            break
        a = int(np.argmax(q_table[s]))
        next_pos = get_next_state(pos, a, obstacles, grid_size)
        total_energy += action_energy_cost(pos, a, next_pos)
        # Count the step type
        if a == STAY:
            breakdown["stay"] += 1
        elif next_pos == pos:
            breakdown["bump"] += 1
        else:
            breakdown["move"] += 1

        sp, _, done = step_env(s, a, pickup_pos, dest_pos, obstacles, grid_size)
        s = sp
        route.append(index_to_state(s, grid_size))

        if done:
            reached = True
            break

    return route, total_energy, breakdown, reached

