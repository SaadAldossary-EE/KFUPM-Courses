GRID_SIZE = 7
OBSTACLE_FRACTION = 0.15  # 15%

# Q-learning hyperparameters
EPISODES = 40000  # tune if needed
ALPHA = 0.1
GAMMA = 0.9
EPSILON = 0.2

# Energy / reward settings
MOVE_COST = 1
STAY_COST = 2
BUMP_COST = 10

PICKUP_BONUS = 30
DROPOFF_REWARD = 100

MAX_STEPS_PER_EPISODE = GRID_SIZE * GRID_SIZE * 2

# Action IDs
UP, DOWN, LEFT, RIGHT, STAY = 0, 1, 2, 3, 4
ACTIONS = 5

# ============================================================
