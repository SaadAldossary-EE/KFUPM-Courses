                         EPISODES, ALPHA, GAMMA, EPSILON, GRID_SIZE)

        # Greedy route + energy accounting
    route, total_energy, breakdown, ok = greedy_route(
        q_table, start_pos, pickup_pos, dest_pos, obstacles, GRID_SIZE
    )

